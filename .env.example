# Banco de dados local
POSTGRES_DB=(NOME_BANCO)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=(SUA_SENHA)

# Banco de dados SUPABASE
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

#Connection String usada pelo .NET / EF Core
ConnectionStrings=Host=localhost;Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}
ConnectionStrings_Default=Host=${SUPABASE_DB_HOST};Port=${SUPABASE_DB_PORT};Database=${SUPABASE_DB_NAME};Username=${SUPABASE_DB_USER};Password=${SUPABASE_DB_PASSWORD}

# JWT (gere uma chave forte de pelo menos 32 caracteres em produção)
JWT_SECRET=troque-esta-chave-em-producao-min-32-chars
JWT_ISSUER=PdvSistema
JWT_AUDIENCE=PdvSistemaClientes
JWT_EXPIRATION_MINUTES=60

# Usuário administrador criado no seed inicial
ADMIN_LOGIN=(SEU_USUARIO)
ADMIN_PASSWORD=(SUA_SENHA_USUARIO)

# Frontend
API_URL=http://localhost:5000/api

ASPNETCORE_ENVIRONMENT=Development
